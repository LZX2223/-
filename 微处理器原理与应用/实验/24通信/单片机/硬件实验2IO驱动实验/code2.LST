   1          #include <reg52.h>//引入单片机的寄存器定义文件
   2          void delay(unsigned int n) 
   3          {
   4   1          unsigned int i, j;
   5   1          for(i = 0; i < n; i++)//循环执行n次
   6   1              for(j = 0; j < 125; j++);//内层循环，实现延迟操作
   7   1                      /*更确切的来说，这里的内循环是通过对变量j的累加来占用处理器的时间
   8   1                      （一次内循环（加法操作）对应着一次时钟周期）使得处理器不能继续指向下一条指令
   9   1                      从而实现延时效果
  10   1                      在这里引入延迟的目的是使得LED灯的状态改变有一定的时间间隔，
  11   1                      使LED灯的状态改变时有明显的时间差，让人能够观察到LED灯的状态变化*/
  12   1      }
  13          void main() 
  14          {
  15   1          unsigned char led_status = 0x01;//记录led灯的初始状态
  16   1          P0= 0XFE;//将0xFE的值写入P0口，将其第0位设为低电平，其他位设为高电平
  17   1          while(1) 
  18   1              {
  19   2              delay(200); //引入延迟，使LED灯的状态改变有一定时间间隔
  20   2              led_status = led_status << 1;//左移1位，改变LED灯的状态
  21   2              if(led_status == 0)
  22   2              led_status = 0x01;//如果到达边界，则进行复位处理
  23   2              P0=~led_status;//将led_status的值取反后写入P0口从而实现对led的控制     
  24   2          }
  25   1      }


