`timescale 1ns / 1ps
module TRAFFIC_CTRL_TB;

    reg         CLK_TB;
    wire        RST_TB;
    wire [2:0]  MAIN_TB;
    wire [2:0]  ALTER_TB;

    parameter CLK_PERIOD = 2;

    // 实例化设计模块
    TRAFFIC_CTRL uut (
        .CLK(CLK_TB),
        .RST(RST_TB),
        .MAINLIGHT(MAIN_TB),
        .ALTERLIGHT(ALTER_TB)
    );

    // 时钟生成
    always begin
        CLK_TB = 1'b0;
        #(CLK_PERIOD/2);
        CLK_TB = 1'b1;
        #(CLK_PERIOD/2);
    end

    // 复位信号控制
    initial begin
        #2 RST_TB = 1'b1;
        #2 RST_TB = 1'b0;
    end

endmodule