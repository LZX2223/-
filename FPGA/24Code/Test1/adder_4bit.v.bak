`timescale 1ns / 1ps // 定义时间单位为1ns，时间精度为1ps

module ADD16_tb; // 定义16位加法器的测试模块
   reg [15:0] a; // 16位加数输入，用于测试
   reg [15:0] b; // 16位被加数输入，用于测试
   reg      cin; // 进位输入，用于测试
   wire [15:0] DOUT1; // 16位加法结果输出，用于验证
   wire        COUT1; // 进位输出，用于验证
   parameter   clk_period = 5; // 定义时钟周期为5个时间单位

   // 实例化16位加法器模块
   ADD16 U1(.a(a), .b(b), .cin(cin), .dout(DOUT1), .cout(COUT1));

   // 测试过程块
   always
   begin: pr1
      // 测试用例1
      a <= 16'b0101010101010010; // 设置加数
      b <= 16'b0100101010000100; // 设置被加数
      cin <= 1'b1; // 设置进位输入
      #(clk_period); // 等待一个时钟周期

      // 测试用例2
      a <= 16'b0111011011110010; // 更新加数
      b <= 16'b0111101010000100; // 更新被加数
      cin <= 1'b0; // 更新进位输入
      #(clk_period); // 等待一个时钟周期

      // 测试用例3
      a <= 16'b1001011011110010; // 更新加数
      b <= 16'b1001101000000100; // 更新被加数
      cin <= 1'b1; // 更新进位输入
      #(clk_period); // 等待一个时钟周期

      // 测试用例4
      a <= 16'b1101011011110010; // 更新加数
      b <= 16'b1011101001110100; // 更新被加数
      cin <= 1'b1; // 更新进位输入
      #(clk_period); // 等待一个时钟周期
   end
endmodule
