module ADD16(a, b, cin, dout, cout); // 定义16位加法器模块
   input [15:0]  a; // 16位加数输入，范围从第0位到第15位
   input [15:0]  b; // 16位被加数输入，范围从第0位到第15位
   input         cin; // 来自低位的进位输入
   output [15:0] dout; // 16位加法结果输出，范围从第0位到第15位
   output        cout; // 加法结果的进位输出

   wire [16:0]   dout17; // 17位中间结果，用于存储加法和进位
   wire [16:0]   a17; // 17位加数，用于扩展输入a
   wire [16:0]   b17; // 17位被加数，用于扩展输入b

   assign a17 = {1'b0, a}; // 将16位加数a扩展为17位，最高位补0
   assign b17 = {1'b0, b}; // 将16位被加数b扩展为17位，最高位补0
   assign dout17 = a17 + b17 + cin; // 17位加法运算，包括进位
   assign dout = dout17[15:0]; // 取低16位作为加法结果输出
   assign cout = dout17[16]; // 取最高位作为进位输出
endmodule