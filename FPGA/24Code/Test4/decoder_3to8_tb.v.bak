`timescale 1ns / 1ps
module decoder_3to8_tb;

    reg G1, G2A, G2B;
    reg [2:0] A;
    wire [7:0] Y;

    decoder_3to8 uut (
        .G1(G1), .G2A(G2A), .G2B(G2B),
        .A(A), .Y(Y)
    );

    initial begin
        $display("========== 3-8线译码器仿真开始 ==========");
        
        // 使能无效测试
        G1=0; G2A=0; G2B=0; A=0; #20;
        
        // 使能有效，依次测试每个输出
        G1=1; G2A=0; G2B=0;
        for (integer i = 0; i < 8; i = i + 1) begin
            A = i; #20;
            $display("A=%b, Y=%b", A, Y);
        end
        
        // 使能无效测试
        G1=0; #20;
        G2A=1; #20;
        G2B=1; #20;
        
        $display("========== 仿真结束 ==========");
        $finish;
    end
endmodule