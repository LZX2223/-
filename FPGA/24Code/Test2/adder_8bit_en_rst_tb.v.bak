`timescale 1ns / 1ps
module adder_8bit_en_rst_tb;

    reg        clk, rst, en;
    reg [7:0]  A, B;
    reg        Cin;
    wire [7:0] Sum;
    wire       Cout;

    // 实例化被测模块
    adder_8bit_en_rst uut (
        .clk(clk), .rst(rst), .en(en),
        .A(A), .B(B), .Cin(Cin),
        .Sum(Sum), .Cout(Cout)
    );

    // 时钟生成（周期 20ns）
    initial clk = 0;
    always #10 clk = ~clk;

    initial begin
        $display("========== 8位带使能复位全加器仿真开始 ==========");

        rst = 1; en = 0; A = 0; B = 0; Cin = 0; #30;   // 异步复位
        rst = 0; en = 1;

        // 测试1：普通加法 + 进位
        A = 8'h05; B = 8'h0A; Cin = 1; #40;
        $display("Test1: %h + %h + %b = %h , cout=%b", A, B, Cin, Sum, Cout);

        // 测试2：使能关闭（输出应保持）
        en = 0; A = 8'hFF; B = 8'hFF; #40;
        $display("Test2 (en=0): Sum=%h , Cout=%b (应保持不变)", Sum, Cout);

        // 测试3：使能打开 + 溢出
        en = 1; A = 8'hFF; B = 8'h01; Cin = 1; #40;
        $display("Test3: %h + %h + %b = %h , cout=%b", A, B, Cin, Sum, Cout);

        // 测试4：异步复位
        rst = 1; #30; rst = 0;
        $display("Test4 (rst=1): Sum=%h , Cout=%b", Sum, Cout);

        #100;
        $display("========== 仿真结束 ==========");
        $finish;
    end
endmodule