`timescale 1ns / 1ps
module priority_encoder_tb;

    reg EI;
    reg [7:0] I;
    wire [2:0] Y;
    wire GS, EO;

    priority_encoder_8to3 uut (
        .EI(EI), .I(I), .Y(Y), .GS(GS), .EO(EO)
    );

    initial begin
        $display("========== 8-3优先编码器仿真开始 ==========");
        
        EI = 1; I = 8'hFF; #20;
        EI = 0;                // 使能有效
        
        // 测试优先级
        I = 8'b11111111; #20;  // 无输入
        I = 8'b01111111; #20;  // I7有效
        I = 8'b10111111; #20;  // I6有效
        I = 8'b11011111; #20;  // I5有效
        I = 8'b11101111; #20;  // I4有效
        I = 8'b11110111; #20;  // I3有效
        I = 8'b11111011; #20;  // I2有效
        I = 8'b11111101; #20;  // I1有效
        I = 8'b11111110; #20;  // I0有效
        
        // 多个输入同时有效（验证优先级）
        I = 8'b11011011; #20;  // I5和I3同时有效，应优先I5
        
        EI = 1; #20;           // 使能无效
        
        $display("========== 仿真结束 ==========");
        $finish;
    end
endmodule